APP_NAME=AI Telegram Chat Bot Assistant
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
PUBLIC_DASHBOARD_URL=http://localhost:5173
DATABASE_URL=sqlite:///./assistant.db
BOT_MODE=polling
TELEGRAM_BOT_TOKEN=fill_me
TELEGRAM_WEBHOOK_SECRET=fill_me
GROQ_API_KEY=fill_me
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
MAX_VOICE_FILE_MB=20
ADMIN_API_TOKEN=fill_me
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=change_me
SESSION_SECRET=change_me_long_random_secret
SESSION_EXPIRY_HOURS=12
FREE_DAILY_LIMIT=40
VIP_DAILY_LIMIT=300
VIP_PLAN_PRICE_USD=3.0
VIP_DURATION_DAYS=30
PAYMENT_MODE=demo
BAKONG_KHQR_ACCOUNT_ID=
BAKONG_KHQR_MERCHANT_NAME=
BAKONG_KHQR_MERCHANT_CITY=Phnom Penh
BAKONG_KHQR_COUNTRY_CODE=KH
BAKONG_KHQR_MERCHANT_ID=
BAKONG_KHQR_ACQUIRING_BANK=
BAKONG_KHQR_STORE_LABEL=
BAKONG_KHQR_TERMINAL_LABEL=
BAKONG_KHQR_CALLBACK_URL=
VERIFY_ABUSE_THRESHOLD=5
MAX_INPUT_CHARS=4000
ACTIVE_REQUEST_TIMEOUT_SECONDS=300
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
